# Postgres (local or hosted). For Supabase, use the URI from Settings → Database.
# Session/transaction pooler goes in DATABASE_URL. Direct (port 5432) goes in DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres?sslmode=require"

# Cookie encryption for the app session. Must be at least 32 characters.
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# AES-256 key material for encrypting Gmail tokens at rest.
TOKEN_ENCRYPTION_KEY="replace-with-another-long-random-string-32+"

# Google OAuth (Gmail send). See README. Do not request gmail.readonly or mailbox scopes.
EMAIL_PROVIDER=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_ALLOWED_EMAIL=saket.amanana@gmail.com

# OpenAI-compatible LLM. Leave LLM_API_KEY empty to use grounded deterministic analysis.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Optional web search API. Seeded university crawling still works without this.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_API_URL=

# Resume PDF. Relative to the project root unless absolute. Do not commit the PDF.
RESUME_PATH=data/resume.pdf
# On Railway, keep a copy at /app/resume-data/resume.pdf as well. Startup copies that onto data/resume.pdf.

# Sending safety
MAX_EMAILS_PER_DAY=15
PROFESSOR_COOLDOWN_DAYS=90
MIN_RELEVANCE_SCORE=65
AUTOPILOT_MIN_SCORE=80
AUTO_SEND=false
GUESS_EMAILS=false
DRY_RUN=true
CRAWL_DELAY_MS=1000

# n8n receives researched drafts. This app does not Gmail-send through that webhook.
N8N_WEBHOOK_URL=https://saketamanana.app.n8n.cloud/webhook/professor-outreach

# Availability wording lives in Settings (AVAILABILITY_SENTENCE), not in this file.

# Shared unlock secret for the hosted app. Required in production (Railway).
# Leave empty for local development. Never commit the real value.
APP_ACCESS_SECRET=
